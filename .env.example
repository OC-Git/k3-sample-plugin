# K3 Plugin Deploy Configuration
# Copy this file to .env and fill in your values

# Your K3 API token (create one in K3 under Account → API-Token)
API_TOKEN=your-api-token

# The UUID of your plugin — shown in K3 under Meine Plugins → Plugin bearbeiten
PLUGIN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# K3 backend URL (default: production)
BACKEND_URL=https://k3-api.objectcode.de

# Module Federation name — vite.config.ts liest diesen Wert via loadEnv()
# Muss eindeutig sein (z.B. dein-plugin-name)
FEDERATION_NAME=k3-ring

# Exposed module name — vite.config.ts nutzt diesen Wert für exposes: { "./Plugin": ... }
FEDERATION_MODULE=Plugin
